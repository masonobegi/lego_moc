# ---------------------------------------------------------------------------
# BrickThrift configuration
#
# Copy to .env.local. EVERY variable here is OPTIONAL.
# With no .env.local at all the app runs in DEMO MODE and all features work.
# ---------------------------------------------------------------------------

# --- Pricing mode ----------------------------------------------------------
# "demo" (default) | "bricklink"
# "bricklink" additionally requires all four BRICKLINK_* values below; if any
# are missing the app logs a warning and falls back to demo mode.
PRICE_SOURCE=demo

# --- Live BrickLink pricing (optional) -------------------------------------
# Register at https://www.bricklink.com/v2/api/register_consumer.page
# NOTE: BrickLink API credentials are IP-locked - you must register the public
# IP address your server will call from. Rate limit: 5000 requests/day.
# These are read on the SERVER ONLY and are never sent to the browser.
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN_VALUE=
BRICKLINK_TOKEN_SECRET=

# Price guide options. "stock" = current items for sale, "sold" = last 6 months.
BRICKLINK_GUIDE_TYPE=stock
# "N" = new, "U" = used
BRICKLINK_CONDITION=N
BRICKLINK_CURRENCY=USD
# Optional store-location filters (see docs/RESEARCH.md section 6)
BRICKLINK_COUNTRY_CODE=
BRICKLINK_REGION=

# --- Rebrickable catalog (optional) ----------------------------------------
# Free API key from https://rebrickable.com/api/
# Only used by `npm run catalog:import`, never at request time.
REBRICKABLE_API_KEY=

# --- Parts library ---------------------------------------------------------
# Where to look for the full LDraw parts library after `npm run parts:fetch`.
# Defaults to <repo>/public/ldraw-full. The small bundled subset in
# <repo>/public/ldraw is always used as a fallback.
LDRAW_LIBRARY_PATH=
